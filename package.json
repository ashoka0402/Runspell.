{
  "name": "runspell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:canvas",
    "build:canvas": "vite build --config canvas/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/m0/*.test.ts tests/m1/*.test.ts",
    "test:browser": "playwright test",
    "preview": "py -m http.server 8000 --bind 127.0.0.1"
  },
  "dependencies": {
    "@xyflow/react": "13.0.2",
    "gsap": "3.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
